# ARBITR8DER Single Source of Truth .env
# This is the ONLY .env. Both root and kalshi_desk read from here.
# Copy this file to ".env" at the repo root: cp .env.example .env
# kalshi_desk/.env does not exist. TradingStudioSettings resolves this file
# by absolute path from the package location (not CWD-relative).

# --- OpenCode / OpenAI / Claude CLI routing ---
OPENCODE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_MODEL=big-pickle
CLAUDE_CODE_USE_OPENAI=1

# --- Kalshi ---
# Get API key ID from Kalshi dashboard. Private key PEM goes at
# kalshi_desk/streams/kalshi_private.pem (gitignored).
AR8_KALSHI_API_KEY_ID=
# Path is resolved relative to kalshi_desk/streams/ directory.
AR8_KALSHI_PRIVATE_KEY_PATH=kalshi_private.pem

# --- Trading ---
AR8_WALLET_MODE=paper                # paper | armed
AR8_TRADING_MODE=hold                # hold | buy | sell
AR8_TICK_INTERVAL=60

# --- Database (currently unused post-SQLite migration; settings still read) ---
AR8_DB_HOST=localhost
AR8_DB_PORT=5432
AR8_DB_NAME=arbitr8der
AR8_DB_USER=postgres
AR8_DB_PASSWORD=

# --- Safety ---
AR8_AUTO_ARM=false                   # never set true without operator confirmation
AR8_DRY_RUN=true                     # simulate by default
