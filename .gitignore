# Local env — NEVER commit. Single source of truth: ARBITR8DER/.env
.env
.env.bak
.env.local

# Local key storage — NEVER commit. Contains PATs, API keys, SSH references.
agents/KEYS

# Python
*.pyc
__pycache__/
*.egg-info/
*.egg
dist/
build/

# Trading studio runtime data — only trading_studio/runtime/ is real.
# The runtime/ at the repo root is vestigial and ignored so it cannot come back.
/runtime/
trading_studio/runtime/data/
trading_studio/runtime/state/
trading_studio/runtime/logs/
trading_studio/runtime/archives/
trading_studio/runtime/*.db
trading_studio/runtime/*.db-wal
trading_studio/runtime/*.db-shm
trading_studio/runtime/*.log
trading_studio/runtime/*.lock
trading_studio/runtime/*.pid
trading_studio/runtime/*.tmp

# Local virtualenv + package metadata
trading_studio/.env
trading_studio/.venv/

# IDE / editor junk
.idea/
.vscode/
.qodo/            # VSCode Qodo extension auto-creates this — delete on sight
.dart_tool/
.cache/
.pytest_cache/

# OS junk
.DS_Store
Thumbs.db

# Streams (Kalshi private key) — gitignored at repo level defensively.
